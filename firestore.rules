rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isBuyer() {
      return hasRole('buyer');
    }
    
    function isSeller() {
      return hasRole('seller');
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isEmailVerified() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && 
                       request.resource.data.keys().hasAll(['email', 'fullName', 'role']) &&
                       request.resource.data.role in ['buyer', 'seller'];
      allow update: if isOwner(userId) && 
                       request.resource.data.role == resource.data.role; // Prevent role changes
      allow delete: if false; // Prevent deletion
    }
    
    // Properties collection
    match /properties/{propertyId} {
      // Read: authenticated users can read properties, but "Waiting for Admin Approval" properties are only visible to owner and admins
      allow read: if isAuthenticated() && 
                     (resource.data.pro_status != 'Waiting for Admin Approval' || 
                      resource.data.sellerId == request.auth.uid || 
                      isAdmin());
      
      // Create: sellers with verified email can create properties
      allow create: if isSeller() && 
                       isEmailVerified() &&
                       request.resource.data.sellerId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['title', 'description', 'price', 'region', 'address', 'propertyType', 'status', 'sellerId']) &&
                       request.resource.data.status in ['available', 'under_offer', 'sold'] &&
                       request.resource.data.price > 0;
      
      // Update: sellers can update their own properties, but only admins can approve pro_status
      allow update: if (isSeller() && 
                        resource.data.sellerId == request.auth.uid &&
                        request.resource.data.sellerId == resource.data.sellerId && // Prevent sellerId changes
                        // If pro_status is being changed to 'Approved', only admins can do it
                        (request.resource.data.pro_status == resource.data.pro_status || 
                         request.resource.data.pro_status != 'Approved' || 
                         isAdmin())) ||
                       // Admins can update any property including pro_status approval
                       isAdmin();
      
      allow delete: if isSeller() && 
                       resource.data.sellerId == request.auth.uid;
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && 
                     (resource.data.buyerId == request.auth.uid || 
                      resource.data.sellerId == request.auth.uid);
      allow create: if isBuyer() && 
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['listingId', 'buyerId', 'sellerId', 'requestedDateTime', 'status']) &&
                       request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && 
                       (resource.data.buyerId == request.auth.uid || 
                        resource.data.sellerId == request.auth.uid) &&
                       request.resource.data.status in ['pending', 'confirmed', 'declined', 'cancelled'] &&
                       request.resource.data.buyerId == resource.data.buyerId && // Prevent ID changes
                       request.resource.data.sellerId == resource.data.sellerId &&
                       request.resource.data.listingId == resource.data.listingId;
      allow delete: if false; // Prevent deletion, use status updates
    }
    
    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isBuyer() && 
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['listingId', 'buyerId', 'rating', 'comment']) &&
                       request.resource.data.rating >= 1 && 
                       request.resource.data.rating <= 5 &&
                       request.resource.data.comment.size() >= 10 &&
                       request.resource.data.comment.size() <= 500;
      allow update, delete: if false; // Immutable after creation
    }
    
    // Regions collection
    match /regions/{regionId} {
      allow read: if true; // Public read
      allow write: if false; // Admin only via backend
    }
    
    // Verification tokens collection (backend only - no client access)
    match /verification_tokens/{tokenId} {
      allow read: if false; // Backend only
      allow write: if false; // Backend only
    }
    
    // Property reports collection (users can create, admins can read/update)
    match /property_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
                       request.resource.data.reporterId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['propertyId', 'reporterId', 'reason', 'createdAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Rate limits collection (backend only - no client access)
    match /rate_limits/{limitId} {
      allow read: if false; // Backend only
      allow write: if false; // Backend only
    }
    
    // Brochures collection (authenticated users can read)
    match /brochures/{brochureId} {
      allow read: if isAuthenticated();
      allow write: if false; // Backend only
    }
  }
}
