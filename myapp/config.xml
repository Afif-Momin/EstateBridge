<widget id="com.estatebridgeapp.myapp" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>EstateBridge</name>
    <description>EstateBridge Real Estate App</description>
    <author email="dev@estatebridge.com" href="https://estatebridge.com">
        EstateBridge Development Team
    </author>

    <!-- ✅ Start Page -->
    <content src="index.html" />
    
    <!-- ✅ Allow Navigation Fix -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" /> <!-- ✅ Allows internal navigation between pages -->

    <!-- ✅ Fix for Local File Access in Cordova -->
    <platform name="android">
        <preference name="AndroidPersistentFileLocation" value="Internal" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" /> <!-- ✅ Allows local HTML/JS navigation -->
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="android-minSdkVersion" value="22" />

        <!-- ✅ Firebase Permissions -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
        </config-file>

        <!-- ✅ Firebase Plugins -->
        <plugin name="cordova-plugin-firebase-authentication" />
        <plugin name="cordova-plugin-inappbrowser" />

        <!-- ✅ Fix Google Services JSON Path -->
        <resource-file src="google-services.json" target="app/src/main/google-services.json" />
    </platform>

    <!-- ✅ iOS Platform Configurations -->
    <platform name="ios">
        <preference name="ios-CordovaWebViewEngine" value="CDVWKWebViewEngine" />
        <preference name="WKWebViewOnly" value="true" />

        <!-- ✅ Firebase Plugins -->
        <plugin name="cordova-plugin-firebase-authentication" />
    </platform>

</widget>
